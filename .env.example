# Copie para .env e ajuste. Se ADMIN_PASSWORD ficar vazio, uma senha é gerada
# no primeiro acesso e gravada no .env.
PORT=3000
ADMIN_EMAIL=admin@umjiu.local
ADMIN_PASSWORD=
# Em produção (HTTPS atrás de proxy):
# NODE_ENV=production
# TRUST_PROXY=1
# Pasta do banco e das fotos (use um disco persistente na hospedagem):
# DATA_DIR=./data
# SEED_DEMO=0   -> não cria o conteúdo de demonstração
